SECRET_KEY=cambia-esto-por-una-clave-segura-aleatoria
DATABASE_URL=sqlite:///./granja.db
BASE_URL=http://localhost:8000
UPLOADS_DIR=uploads
COOKIE_SECURE=false

# Telegram Bot (crea un bot con @BotFather en Telegram y pega aquí su token)
TELEGRAM_BOT_TOKEN=
# Chat ID del destinatario (escribe a @userinfobot en Telegram para obtener el tuyo)
TELEGRAM_CHAT_ID=

# Email de confirmación de reservas (módulo Agroturismo) — opcional, sin esto
# simplemente no se envía el correo al visitante (el aviso a Telegram sí llega)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Datos de la explotación
EXPLOTACION_NOMBRE=Mi Ganadería
EXPLOTACION_REGA=ES-33-XXXXX

# Alertas — días de antelación
ALERTA_PREPARTO_DIAS=30,15,7
ALERTA_STOCK_MINIMO_DIAS=21
ALERTA_VACIA_DIAS=90
ALERTA_TAREA_DIAS=3,1,0
ALERTA_REVISION_DIAS=30,15,7

# Módulos opcionales de esta instalación — "todos" o lista separada por comas:
# queseria,analisis_leche,maquinaria,alimentacion,economia,cuaderno,agroturismo
MODULOS=todos

# Instancia de demostración — datos de ejemplo, se reinician cada noche
DEMO_MODE=false
